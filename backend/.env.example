# Copy to .env when needed. Never commit real credentials.
APP_ENV=development
DATABASE_URL=sqlite:///./paypilot.db

# PayPal Developer Dashboard > Apps & Credentials > Sandbox credentials.
# The backend uses the fixed Sandbox URL: https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
# Optional sanitized Transaction Search metadata logs (no payer details or transaction IDs).
PAYPAL_TRANSACTION_DIAGNOSTICS=0
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=

# Optional deterministic fraud-rule tuning (defaults shown).
FRAUD_AMOUNT_MIN_HISTORY=5
FRAUD_HIGH_AMOUNT_MULTIPLE=3
FRAUD_VELOCITY_WINDOW_MINUTES=10
FRAUD_VELOCITY_COUNT=5
FRAUD_DENIED_WINDOW_MINUTES=60
FRAUD_DENIED_COUNT=3
FRAUD_REFUND_WINDOW_DAYS=7
FRAUD_REFUND_COUNT=3
FRAUD_REFUND_BASELINE_DAYS=30
FRAUD_REFUND_MIN_SALES=5
FRAUD_REFUND_RATIO=0.35
FRAUD_FREQUENCY_WINDOW_HOURS=24
FRAUD_FREQUENCY_MIN_COUNT=5
FRAUD_FREQUENCY_MULTIPLE=3
FRAUD_FREQUENCY_MIN_HISTORY=5
FRAUD_NOVEL_CODE_MIN_HISTORY=5
